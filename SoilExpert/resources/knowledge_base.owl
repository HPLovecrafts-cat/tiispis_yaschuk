    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#процентСоответствия">

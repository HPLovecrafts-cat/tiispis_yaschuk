    <описаниеУсловия>влажность почвы ниже нормы для вида</описаниеУсловия>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Растение_Фиалка1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>

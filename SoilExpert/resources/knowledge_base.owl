  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Избыток_удобрений">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Избыток удобрений (засоление почвы)</названиеПричины>
    <рекомендация>Прекратить подкормки, промыть почву обильным поливом, удалить солевой налёт или заменить верхний слой.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Краевой_ожог_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Краевой_ожог_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Солевой_налёт_на_почве"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Сухие_кончики_листьев"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_подкормки_избыточные"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Повышенная_кислотность">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Повышенная кислотность почвы</названиеПричины>
    <рекомендация>Внести известь или доломитовую муку, повторно измерить pH через 2–3 недели.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Межжилковый_хлороз"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Межжилковый_хлороз"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Замедление_роста"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_pH_низкий"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Усл_pH_высокий">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <показатель>pH</показатель>
    <отношение>вышеНормы</отношение>
    <значение></значение>
    <описаниеУсловия>pH выше оптимума для вида (щелочная почва)</описаниеУсловия>
  </rdf:Description>

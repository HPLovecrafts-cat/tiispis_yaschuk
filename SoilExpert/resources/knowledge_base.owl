<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://www.semanticweb.org/soil_monitoring#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Переувлажнение">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Переувлажнение почвы</названиеПричины>
    <рекомендация>Сократить полив, дать почве просохнуть, обеспечить дренаж; при загнивании пересадить, удалив поражённые корни.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Загнивание_корней"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Загнивание_корней"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Плесень_на_почве"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_влажность_высокая"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#pHМин">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Дефицит_питания">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Дефицит питательных веществ</названиеПричины>
    <рекомендация>Внести комплексное минеральное удобрение, в дальнейшем подкармливать регулярно по норме.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Замедление_роста"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Замедление_роста"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Мелкие_листья"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Слабое_цветение"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_подкормки_недостаточные"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Пожелтение листьев</названиеПризнака>
    <степеньВыраженности>средняя</степеньВыраженности>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Оценка_Фиалка1_ДефицитВлаги">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ДиагностическаяОценка"/>
    <процентСоответствия rdf:datatype="http://www.w3.org/2001/XMLSchema#float">85.0</процентСоответствия>
    <степеньУверенности>Высокая вероятность</степеньУверенности>
    <пояснение>Совпали признаки: увядание, пожелтение листьев; влажность почвы ниже нормы</пояснение>
    <относитсяКПричине rdf:resource="http://www.semanticweb.org/soil_monitoring#Дефицит_влаги"/>
    <дляРастения rdf:resource="http://www.semanticweb.org/soil_monitoring#Растение_Фиалка1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Поражение_вредителями">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Поражение вредителями</названиеПричины>
    <рекомендация>Изолировать растение, обработать инсектицидом/акарицидом, повторить обработку через 7–10 дней.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Насекомые_на_растении"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Насекомые_на_растении"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Пятна_на_листьях"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Паутина_на_листьях"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Деформация_листьев"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#описаниеУсловия">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#оцениваетсяНа">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#Растение"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Усл_pH_низкий">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <показатель>pH</показатель>
    <отношение>нижеНормы</отношение>
    <значение></значение>
    <описаниеУсловия>pH ниже оптимума для вида (кислая почва)</описаниеУсловия>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Картофель">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Картофель</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">60.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.0</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">12.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Фикус">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Фикус</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">65.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">16.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Усл_температура_высокая">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <показатель>температура</показатель>
    <отношение>вышеНормы</отношение>
    <значение></значение>
    <описаниеУсловия>температура выше допустимой для вида</описаниеУсловия>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Фиалка">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Фиалка (сенполия)</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">70.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">18.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">27.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Орхидея">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Орхидея (фаленопсис)</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">30.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">60.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">18.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">30.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Скручивание_листьев">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Скручивание листьев</названиеПризнака>
    <степеньВыраженности>средняя</степеньВыраженности>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#названиеПризнака">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Повышенная_щёлочность">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Повышенная щёлочность почвы</названиеПричины>
    <рекомендация>Подкислить почву (торф, сера, хвойный опад), поливать мягкой водой, применить хелаты железа.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Хлороз_молодых_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Хлороз_молодых_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Замедление_роста"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Мелкие_листья"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_pH_высокий"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Замедление_роста">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Замедление роста</названиеПризнака>
    <степеньВыраженности>средняя</степеньВыраженности>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Дефицит_влаги">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Дефицит влаги</названиеПричины>
    <рекомендация>Увеличить частоту полива, поливать до полного промачивания кома, проверить дренаж и мульчировать почву.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Сухие_кончики_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Скручивание_листьев"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_влажность_низкая"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Усл_подкормки_избыточные">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <показатель>подкормки</показатель>
    <отношение>входитВ</отношение>
    <значение>избыточные</значение>
    <описаниеУсловия>подкормки избыточные</описаниеУсловия>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Переохлаждение">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПричинаОтклонения"/>
    <названиеПричины>Переохлаждение</названиеПричины>
    <рекомендация>Перенести растение в тёплое место, исключить сквозняки, поливать тёплой водой.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Потемнение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Потемнение_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Опадание_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_температура_низкая"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Пшеница">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Пшеница</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">60.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.0</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">8.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Солевой_налёт_на_почве">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Белый солевой налёт на почве</названиеПризнака>
    <степеньВыраженности>средняя</степеньВыраженности>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Огурец">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Огурец</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">70.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">85.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.0</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">18.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">32.0</температураМакс>

  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#проявляетсяУ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/soil_monitoring#Растение"/>

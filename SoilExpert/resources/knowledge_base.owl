    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Томат</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">60.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">80.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.0</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">30.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Мелкие_листья">

    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Увядание</названиеПризнака>
    <степеньВыраженности>высокая</степеньВыраженности>
  </rdf:Description>

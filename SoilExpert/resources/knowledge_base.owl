    <давностьПризнаков rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</давностьПризнаков>
    <относитсяКВиду rdf:resource="http://www.semanticweb.org/soil_monitoring#Вид_Фиалка"/>
    <имеетПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <имеетПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Пожелтение_листьев"/>
    <оцениваетсяНа rdf:resource="http://www.semanticweb.org/soil_monitoring#Дефицит_влаги"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Потемнение_листьев">

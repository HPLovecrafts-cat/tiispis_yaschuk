  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Вид_Голубика">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ВидРастения"/>
    <названиеВида>Голубика</названиеВида>
    <влажностьМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">55.0</влажностьМин>
    <влажностьМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">75.0</влажностьМакс>
    <pHМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">4.0</pHМин>
    <pHМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5.5</pHМакс>
    <температураМин rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10.0</температураМин>
    <температураМакс rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0</температураМакс>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Усл_температура_низкая">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#УсловиеПочвы"/>
    <показатель>температура</показатель>
    <отношение>нижеНормы</отношение>
    <значение></значение>
    <описаниеУсловия>температура ниже допустимой для вида</описаниеУсловия>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Тепловой_стресс">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>

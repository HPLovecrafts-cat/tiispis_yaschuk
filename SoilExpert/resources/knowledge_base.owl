    <названиеПризнака>Мелкие новые листья</названиеПризнака>
    <степеньВыраженности>низкая</степеньВыраженности>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#Опадание_листьев">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/soil_monitoring#ПризнакРастения"/>
    <названиеПризнака>Опадание листьев</названиеПризнака>
    <степеньВыраженности>высокая</степеньВыраженности>
  </rdf:Description>

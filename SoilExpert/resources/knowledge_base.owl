    <названиеПричины>Тепловой стресс (перегрев)</названиеПричины>
    <рекомендация>Притенить растение, обеспечить проветривание, увеличить полив и опрыскивание в утренние часы.</рекомендация>
    <хроническая rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</хроническая>
    <ключевойПризнак rdf:resource="http://www.semanticweb.org/soil_monitoring#Скручивание_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Скручивание_листьев"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Увядание"/>
    <характеризуетсяПризнаком rdf:resource="http://www.semanticweb.org/soil_monitoring#Сухие_кончики_листьев"/>
    <имеетУсловие rdf:resource="http://www.semanticweb.org/soil_monitoring#Усл_температура_высокая"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/soil_monitoring#отношение">
